# BACKEND settings. Copy to deploy/backend/.env and fill in. Never commit .env.

# ---- Generate this whole block with (from the repo root):  node scripts/generate-secrets.mjs
POSTGRES_PASSWORD=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
BANK_ENC_KEY=
OTP_PEPPER=
FILE_URL_SECRET=
ORDER_QR_SECRET=

# ---- Addresses
# This API's public address (upload links, file previews and photos use it)
PUBLIC_API_URL=https://api.example.com
# Frontend addresses allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=https://partners.example.com,https://admin.example.com
# Partners app address (links inside SMS / push messages)
PARTNERS_WEB_URL=https://partners.example.com
JWT_ACCESS_TTL=15m

# ---- Push notifications (Firebase). Key file: deploy/backend/secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=

# ---- SMS / WhatsApp. DEV = no real messages (login codes appear in: docker compose logs api)
SMS_PROVIDER=DEV
WHATSAPP_PROVIDER=DEV
MSG91_AUTH_KEY=
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_ORDER_REMINDER=
MSG91_TEMPLATE_ORDER_MISSED=
MSG91_TEMPLATE_STORE_STATUS=
MSG91_TEMPLATE_STAFF_ADDED=
