# LOCAL DEVELOPMENT settings (pnpm dev). Copy to .env.
# Servers use deploy/backend/.env and deploy/frontend/.env instead — see README.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/delivez_core?schema=public"
API_PORT=4000
# Empty = in-memory (fine for dev)
REDIS_URL=
JWT_ACCESS_TTL=15m

# Optional in dev: Google Maps (else OpenStreetMap) and Firebase push (else logged)
VITE_GOOGLE_MAPS_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=

# SMS: DEV shows messages in Admin → Messages (dev). MSG91 sends real SMS (only to MSG91_TEST_NUMBERS in dev).
SMS_PROVIDER=DEV
WHATSAPP_PROVIDER=DEV
MSG91_AUTH_KEY=
MSG91_TEST_NUMBERS=
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_ORDER_REMINDER=
MSG91_TEMPLATE_ORDER_MISSED=
MSG91_TEMPLATE_STORE_STATUS=
MSG91_TEMPLATE_STAFF_ADDED=
