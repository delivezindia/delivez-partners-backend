# Copy to .env (repo root). After changing it on a server: pm2 restart delivez-api

# ---- Database / cache
DATABASE_URL="postgresql://delivez:PASSWORD@localhost:5432/delivez_core?schema=public"
# Redis on servers (e.g. redis://localhost:6379). Empty = in-memory, local dev only.
REDIS_URL=
API_PORT=4000

# ---- Server secrets — generate with:  pnpm secrets   (paste the output here; not needed for local dev)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
BANK_ENC_KEY=
OTP_PEPPER=
FILE_URL_SECRET=
ORDER_QR_SECRET=

# ---- Addresses (servers)
# This API's public address — upload links, file previews and photos use it
PUBLIC_API_URL=https://partners.api.delivez.com
# Frontend addresses allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=https://partners.delivez.com,https://partners.admin.delivez.com,https://now.delivez.com
# Partners app address (links inside SMS / push messages)
PARTNERS_WEB_URL=https://partners.delivez.com
# Customer app address (links in customer order texts)
LOCAL_WEB_URL=https://now.delivez.com
# Where uploaded files are stored (default: apps/core-api/uploads) — back this folder up
UPLOAD_DIR=

# ---- Online payments (customer app). Without keys the live API refuses customer orders.
# rzp_test_… keys until go-live. Webhook: Razorpay Dashboard → Webhooks → secret
# (events: payment.captured, order.paid, refund.processed, refund.failed)
# dummy = test payments with no real money (remove before launch); otherwise Razorpay keys below
PAYMENT_GATEWAY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- API docs (https://<api>/docs). Live servers: hidden unless BOTH are set; then the browser asks for them.
DOCS_USERNAME=
DOCS_PASSWORD=

# ---- Push notifications (Firebase). Key file: secrets/firebase-service-account.json (not in git),
# or set its path here
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=

# ---- SMS / WhatsApp. DEV = no real messages (login codes appear in: pm2 logs delivez-api)
SMS_PROVIDER=DEV
WHATSAPP_PROVIDER=DEV
# Temporary, until MSG91 is live: true = show login codes on the login screen in production (anyone could log in
# as any number). Ignored automatically once SMS_PROVIDER=MSG91.
OTP_SHOW_IN_RESPONSE=false
MSG91_AUTH_KEY=
# Non-production only: real SMS goes just to these numbers (comma-separated, 10 digits)
MSG91_TEST_NUMBERS=
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_ORDER_REMINDER=
MSG91_TEMPLATE_ORDER_MISSED=
MSG91_TEMPLATE_STORE_STATUS=
MSG91_TEMPLATE_STAFF_ADDED=
# Customer order / lab updates by SMS — only when no push reached any of their devices. false turns them off.
CUSTOMER_SMS_UPDATES=true
MSG91_TEMPLATE_CUST_ACCEPTED=
MSG91_TEMPLATE_CUST_ON_WAY=
MSG91_TEMPLATE_CUST_REJECTED=
MSG91_TEMPLATE_CUST_CANCELLED=
MSG91_TEMPLATE_CUST_FAILED=
MSG91_TEMPLATE_CUST_LAB_CONFIRMED=
MSG91_TEMPLATE_CUST_LAB_REJECTED=
MSG91_TEMPLATE_CUST_LAB_SAMPLE=

# ---- Optional: bank IFSC lookup service (default https://ifsc.razorpay.com)
IFSC_API_URL=
