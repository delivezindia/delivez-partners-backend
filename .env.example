# Copy to .env (repo root). After changing it on a server: pm2 restart delivez-api

# ---- Database / cache
DATABASE_URL="postgresql://delivez:PASSWORD@localhost:5432/delivez_core?schema=public"
# Redis on servers (e.g. redis://localhost:6379). Empty = in-memory, local dev only.
REDIS_URL=
API_PORT=4000
JWT_ACCESS_TTL=15m

# ---- Server secrets — generate with:  pnpm secrets   (paste the output here; not needed for local dev)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
BANK_ENC_KEY=
OTP_PEPPER=
FILE_URL_SECRET=
ORDER_QR_SECRET=

# ---- Addresses (servers)
# This API's public address — upload links, file previews and photos use it
PUBLIC_API_URL=https://partners.api.delivez.com
# Frontend addresses allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=https://partners.delivez.com,https://partners.admin.delivez.com
# Partners app address (links inside SMS / push messages)
PARTNERS_WEB_URL=https://partners.delivez.com
# Where uploaded files are stored (default: apps/core-api/uploads) — back this folder up
UPLOAD_DIR=

# ---- API docs (https://<api>/docs). Live servers: hidden unless BOTH are set; then the browser asks for them.
DOCS_USERNAME=
DOCS_PASSWORD=

# ---- Push notifications (Firebase). Key file: secrets/firebase-service-account.json (not in git)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=

# ---- SMS / WhatsApp. DEV = no real messages (login codes appear in: pm2 logs delivez-api)
SMS_PROVIDER=DEV
WHATSAPP_PROVIDER=DEV
# Temporary, until MSG91 is live: true = show login codes on the login screen in production (anyone could log in
# as any number). Ignored automatically once SMS_PROVIDER=MSG91.
OTP_SHOW_IN_RESPONSE=false
MSG91_AUTH_KEY=
# Non-production only: real SMS goes just to these numbers (comma-separated, 10 digits)
MSG91_TEST_NUMBERS=
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_ORDER_REMINDER=
MSG91_TEMPLATE_ORDER_MISSED=
MSG91_TEMPLATE_STORE_STATUS=
MSG91_TEMPLATE_STAFF_ADDED=
